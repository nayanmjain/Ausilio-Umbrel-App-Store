# OneGlanse for Umbrel - Configuration Example
#
# Copy this file to config.env in ~/umbrel/app-data/ausilio-oneglanse/config.env
# to configure optional API keys and settings. This file survives app updates.
#
# Required for response analysis: at least one LLM API key
# APP_ONEGLANSE_OPENAI_API_KEY=sk-...
#
# Alternatively use Anthropic Claude for analysis:
# APP_ONEGLANSE_ANTHROPIC_API_KEY=sk-ant-...
# APP_ONEGLANSE_ANALYSIS_LLM_PROVIDER=claude
#
# Required in self-hosted mode for browser traffic (ThorData proxy):
# APP_ONEGLANSE_THORDATA_PROXY_API_URL=https://...
#
# Optional custom domain / Tailscale URL if accessing outside umbrel.local:8095:
# APP_ONEGLANSE_APP_URL=http://umbrel.local:8095
